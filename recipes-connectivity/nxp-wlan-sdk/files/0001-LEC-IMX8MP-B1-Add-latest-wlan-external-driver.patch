-	t_s8 numbyte_find = 0;
-	t_s8 repeat_find = 0;
-	t_s8 byte_find = 0;
-	t_s8 mask_find = 0;
-	t_s8 dest_find = 0;
-	char dest_seq[50];
-
-	*size = 0;
-	while ((pos = mlan_config_get_line(fp, line, sizeof(line), ln))) {
-		if (strcmp(pos, "}") == 0) {
-			break;
