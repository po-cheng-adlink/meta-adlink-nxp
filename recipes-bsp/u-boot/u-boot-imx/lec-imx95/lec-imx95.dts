#include "../dts/upstream/src/arm64/freescale/imx95-19x19-evk.dts"
#include "lec-imx95-u-boot.dtsi"

/ {
	model = "Adlink i.MX95 lec-imx95 board";
	compatible = "fsl,imx95-19x19-evk", "fsl,imx95", "adlink,lec-imx95";


};

&reg_usb_vbus {
        /delete-property/ gpio;
};

&reg_aqr_stby {
        /delete-property/ gpio;
};

&reg_aqr_en {
        /delete-property/ gpio;
};


/delete-node/ &reg_serdes_en;

&flexspi1 {
        flash@0 {
                spi-tx-bus-width = <1>;
                spi-rx-bus-width = <1>;
        };
};

&lpi2c3 {
        /delete-property/ status;
};

&lpi2c4 {
        /delete-property/ status;
};

&lpi2c5 {
        /delete-property/ status;
};

&lpi2c6 {
        /delete-property/ status;
};

&lpi2c7 {
        /delete-property/ status;
	/delete-node/ tcpc@50;
};

&usb2 {
	/delete-property/ vbus-supply;
};

&usb3_dwc3 {
        dr_mode = "otg";
        /delete-node/ port;
};

&usb3_phy {
        /delete-node/ port;
};

&enetc_port2 {
        status = "disabled";
        /delete-property/ serdes-supply;
        /delete-property/ managed;
};

&enetc_port1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_enetc1>;
 	phy-handle = <&ethphy1>;
 	phy-mode = "rgmii-id";
 	status = "okay";
};

&netc_emdio {
        /delete-property/ phy-supply;

        ethernet-phy@1 {
                eee-broken-1000t;
                /delete-property/ reset-gpios;
                /delete-property/ realtek,clkout-disable;
        };

        ethphy1: ethernet-phy@4 {
                reg = <4>;
                eee-broken-1000t;
                reset-assert-us = <10000>;
                reset-deassert-us = <80000>;
        };
};

&pinctrl_lpi2c3 {
        fsl,pins = <
                IMX95_PAD_GPIO_IO28__LPI2C3_SDA            0x40000b9e
                IMX95_PAD_GPIO_IO29__LPI2C3_SCL            0x40000b9e
        >;
};

&pinctrl_flexspi1 {
        fsl,pins = <
                IMX95_PAD_XSPI1_SS0_B__FLEXSPI1_A_SS0_B                 0x3fe
                IMX95_PAD_XSPI1_SCLK__FLEXSPI1_A_SCLK                   0x3fe
                IMX95_PAD_XSPI1_DATA0__FLEXSPI1_A_DATA_BIT0             0x3fe
                IMX95_PAD_XSPI1_DATA1__FLEXSPI1_A_DATA_BIT1             0x3fe
                IMX95_PAD_XSPI1_DATA2__FLEXSPI1_A_DATA_BIT2             0x3fe
                IMX95_PAD_XSPI1_DATA3__FLEXSPI1_A_DATA_BIT3             0x3fe
        >;
};


&scmi_iomuxc {
        pinctrl_enetc1: enetc1grp {
                fsl,pins = <
                        IMX95_PAD_ENET2_TD3__NETCMIX_TOP_ETH1_RGMII_TD3         0x57e
                        IMX95_PAD_ENET2_TD2__NETCMIX_TOP_ETH1_RGMII_TD2         0x57e
                        IMX95_PAD_ENET2_TD1__NETCMIX_TOP_ETH1_RGMII_TD1         0x57e
                        IMX95_PAD_ENET2_TD0__NETCMIX_TOP_ETH1_RGMII_TD0         0x57e
                        IMX95_PAD_ENET2_TX_CTL__NETCMIX_TOP_ETH1_RGMII_TX_CTL   0x57e
                        IMX95_PAD_ENET2_TXC__NETCMIX_TOP_ETH1_RGMII_TX_CLK      0x5fe
                        IMX95_PAD_ENET2_RX_CTL__NETCMIX_TOP_ETH1_RGMII_RX_CTL   0x57e
                        IMX95_PAD_ENET2_RXC__NETCMIX_TOP_ETH1_RGMII_RX_CLK      0x5fe
                        IMX95_PAD_ENET2_RD0__NETCMIX_TOP_ETH1_RGMII_RD0         0x57e
                        IMX95_PAD_ENET2_RD1__NETCMIX_TOP_ETH1_RGMII_RD1         0x57e
                        IMX95_PAD_ENET2_RD2__NETCMIX_TOP_ETH1_RGMII_RD2         0x57e
                        IMX95_PAD_ENET2_RD3__NETCMIX_TOP_ETH1_RGMII_RD3         0x57e
                >;
        };
};
