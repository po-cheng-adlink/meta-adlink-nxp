+	pcmd_agcs_cfg->nf_margin = pagcs_cfg->nf_margin;
+	pcmd_agcs_cfg->nav_mitigation_th = pagcs_cfg->nav_mitigation_th;
+	pcmd_agcs_cfg->ch_th = pagcs_cfg->ch_th;
+	pcmd_agcs_cfg->min_pkt_percentage = pagcs_cfg->min_pkt_percentage;
+
