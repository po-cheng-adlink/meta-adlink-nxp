-	t_s8 nameid; /**< Name Id. */
-} mef_fields[] = {{"type", NAME_TYPE},	   {"pattern", NAME_PATTERN},
-		  {"offset", NAME_OFFSET}, {"numbyte", NAME_NUMBYTE},
