+	pchan_list = phandle->agcs_info.chan_list;
+	for (chidx = 0; (pchan_list[chidx].chan_number != 0) &&
+			(chidx < WLAN_USER_SCAN_CHAN_MAX) &&
+			((*cur_idx) < WLAN_USER_SCAN_CHAN_MAX);
+	     chidx++) {
