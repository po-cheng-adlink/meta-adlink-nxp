+static bool woal_search_ie(const t_u8 *ie, t_u8 ie_len, t_u8 eid, t_u8 ext_eid)
+{
+	const IEEEtypes_Header_t *pheader = NULL;
+	const t_u8 *pos = NULL;
+	t_u8 ret_len = 0;
+	t_u8 ret = false;
+	t_u8 id = 0;
