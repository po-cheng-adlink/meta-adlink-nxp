-/**
- *  @brief Convert String to Integer
- *  @param buf      A pointer to the string
- *  @return         Integer
- */
-static int atoval(char *buf)
-{
-	if (!strncasecmp(buf, "0x", 2))
-		return a2hex(buf + 2);
-	else if (!ishexstring(buf))
-		return a2hex(buf);
-	else
-		return atoi(buf);
-}
