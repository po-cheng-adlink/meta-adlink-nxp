-static int mlan_get_filter_data(FILE *fp, int *ln, t_u8 *buf, t_u16 *size)
-{
-	t_s32 errors = 0, i;
-	char line[256], *pos = NULL, *pos1 = NULL;
-	t_u16 type = 0;
-	t_u32 pattern = 0;
