+	struct iphdr *iph = NULL;
+
+	eth = (struct ethhdr *)(data);
+	if (eth) {
+		iph = (struct iphdr *)((t_u8 *)eth + sizeof(struct ethhdr));
+		if (iph)
+			return iph->tos & 0xfc;
+	}
+
+	return 0;
+}
