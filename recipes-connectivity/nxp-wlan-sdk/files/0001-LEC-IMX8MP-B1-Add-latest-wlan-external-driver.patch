+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0)
+		__pm_wakeup_event(handle->ws, WAKE_LOCK_HANG);
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(4, 1, 0)
+		__pm_wakeup_event(&handle->ws, WAKE_LOCK_HANG);
+#else
+		wake_lock_timeout(&handle->wake_lock,
+				  msecs_to_jiffies(WAKE_LOCK_HANG));
+#endif
+#endif
+	}
+	LEAVE();
+}
