- *  @param _pos     Output string or NULL
- *  @return         String or NULL
- */
-char *config_get_line(char *s, int size, FILE *stream, int *line, char **_pos)
-{
-	*_pos = mlan_config_get_line(stream, s, size, line);
-	return *_pos;
