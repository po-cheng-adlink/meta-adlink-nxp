+			}
+			break;
+		case MOBILITY_DOMAIN:
+			pnew_entry->pmd_ie =
+				(IEEEtypes_MobilityDomain_t *)pcurrent_ptr;
+			offset = pcurrent_ptr - pnew_entry->pbeacon_buf;
+			pnew_entry->md_offset = (t_u16)(offset);
