From 1398932274a344b14b9e1890145b0e58bbc5c021 Mon Sep 17 00:00:00 2001
From: M Shangavelan <shangavelan.m@adlinktech.com>
Date: Thu, 9 Jul 2026 12:39:26 +0530
Subject: [PATCH 1/2] LEC-IMX8MP-B1: phy led and edid delay support

Signed-off-by: M Shangavelan <shangavelan.m@adlinktech.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 2 ++
 drivers/net/phy/dp83867.c                 | 4 ++--
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index 5453948822ec..8dc473e6e9d0 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -2462,6 +2462,8 @@ static struct edid *dw_hdmi_get_edid(struct dw_hdmi *hdmi,
 	if (!hdmi->ddc)
 		return NULL;
 
+	pr_info("delay 150ms before get edid to waiting for display edid ready!\n");
+	msleep(150);
 	edid = drm_get_edid(connector, hdmi->ddc);
 	if (!edid) {
 		dev_dbg(hdmi->dev, "failed to get edid\n");
diff --git a/drivers/net/phy/dp83867.c b/drivers/net/phy/dp83867.c
index 54860a222d2f..b637452d00ef 100644
--- a/drivers/net/phy/dp83867.c
+++ b/drivers/net/phy/dp83867.c
@@ -951,9 +951,9 @@ static int dp83867_config_init(struct phy_device *phydev)
        if (val < 0)
                return val;
 
-       if ((val & 0xFFFF) != 0x0000) {
+       if ((val & 0xFFFF) != 0x444) {
                val &= ~0xFFFF;
-               val |= 0x0000;
+               val |= 0x444;
                ret = phy_write(phydev, DP83867_LEDCR2, val);
                if (ret)
                        return ret;
-- 
