-		ret = get_txpwrlimit(fp_raw, argv, 0x13, buffer,
-				     sizeof(mlan_ds_misc_chan_trpc_cfg) +
-					     strlen(argv[2]),
-				     cmd);
-		break;
-	case 0xff:
-		ret = get_txpwrlimit(fp_raw, argv, 0, buffer,
-				     sizeof(mlan_ds_misc_chan_trpc_cfg) +
-					     strlen(argv[2]),
-				     cmd);
-		ret = get_txpwrlimit(fp_raw, argv, 0x10, buffer,
