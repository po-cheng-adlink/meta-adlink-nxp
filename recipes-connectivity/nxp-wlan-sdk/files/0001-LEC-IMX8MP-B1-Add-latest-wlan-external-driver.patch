+	HostCmd_DS_802_11_CFG_DATA *pcfg_data = &(pcmd->params.cfg_data);
+	t_u32 len = 0;
+	t_u32 data_offset;
+	pmlan_adapter pmadapter = pmpriv->adapter;
+	t_u8 *temp_pcmd = (t_u8 *)pcmd;
