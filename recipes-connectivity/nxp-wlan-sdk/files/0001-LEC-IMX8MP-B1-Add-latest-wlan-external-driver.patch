+	ptx_pd->bss_num = GET_BSS_NUM(priv);
+	ptx_pd->bss_type = priv->bss_type;
+	ptx_pd->priority = (t_u8)pmbuf->priority;
+	ptx_pd->tx_pkt_type = PKT_TYPE_AMSDU;
