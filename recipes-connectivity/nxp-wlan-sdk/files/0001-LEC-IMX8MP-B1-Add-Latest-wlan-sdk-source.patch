+static t_u8 moal_user_priority_to_qos(t_u32 userPriority)
+{
+	t_u8 aci;
+
+	switch (userPriority) {
+	default:
+	case 0:
+	case 3:
+		/* BE */
+		aci = 3;
+		break;
+
+	case 1:
+	case 2:
+		/* BK */
+		aci = 2;
+		break;
+
+	case 4:
+	case 5:
+		/* VI */
+		aci = 1;
+		break;
+
+	case 6:
+	case 7:
+		/* VO */
+		aci = 0;
+		break;
+	}
+
+	return aci;
+}
